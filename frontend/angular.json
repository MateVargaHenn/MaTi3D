{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "mati3d-public": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/mati3d-public",
      "sourceRoot": "projects/mati3d-public/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/mati3d-public/src/main.ts",
            "tsConfig": "projects/mati3d-public/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/mati3d-public/public"
              }
            ],
            "styles": [
              "projects/mati3d-public/src/tailwind.css",
              "projects/mati3d-public/src/styles.css"
            ],
            "server": "projects/mati3d-public/src/main.server.ts",
            "outputMode": "server",
            "security": {
              "allowedHosts": []
            },
            "ssr": {
              "entry": "projects/mati3d-public/src/server.ts"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "mati3d-public:build:production"
            },
            "development": {
              "buildTarget": "mati3d-public:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    },
    "mati3d-admin": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/mati3d-admin",
      "sourceRoot": "projects/mati3d-admin/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/mati3d-admin/src/main.ts",
            "tsConfig": "projects/mati3d-admin/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/mati3d-admin/public"
              }
            ],
            "styles": [
              "projects/mati3d-admin/src/styles.css"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "mati3d-admin:build:production"
            },
            "development": {
              "buildTarget": "mati3d-admin:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
